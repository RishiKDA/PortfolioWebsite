<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0" metadata-complete="true">

    <display-name>Rishi Kedia Portfolio</display-name>

    <!-- ═══════════════════════════════════════════════
         WELCOME FILE
    ════════════════════════════════════════════════ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ═══════════════════════════════════════════════
         SESSION TIMEOUT — 30 minutes
    ════════════════════════════════════════════════ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ═══════════════════════════════════════════════
         SERVLET DECLARATIONS
    ════════════════════════════════════════════════ -->

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>

    <!-- Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.RegisterServlet</servlet-class>
    </servlet>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>

    <!-- Project Servlet (Admin) -->
    <servlet>
        <servlet-name>ProjectServlet</servlet-name>
        <servlet-class>controller.ProjectServlet</servlet-class>
    </servlet>

    <!-- Skill Servlet (Admin) -->
    <servlet>
        <servlet-name>SkillServlet</servlet-name>
        <servlet-class>controller.SkillServlet</servlet-class>
    </servlet>

    <!-- Contact Servlet -->
    <servlet>
        <servlet-name>ContactServlet</servlet-name>
        <servlet-class>controller.ContactServlet</servlet-class>
    </servlet>

    <!-- ═══════════════════════════════════════════════
         SERVLET URL MAPPINGS
    ════════════════════════════════════════════════ -->

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ProjectServlet</servlet-name>
        <url-pattern>/admin/ProjectServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SkillServlet</servlet-name>
        <url-pattern>/admin/SkillServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ContactServlet</servlet-name>
        <url-pattern>/ContactServlet</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════════════════════════════════
         ERROR PAGES
    ════════════════════════════════════════════════ -->

    <error-page>
        <error-code>404</error-code>
        <location>/WebContent/pages/public/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WebContent/pages/public/500.jsp</location>
    </error-page>

</web-app>
